stages:
  - build
  - test
  - package

variables:
  DOCKER_DRIVER: overlay2
  DOCKER_TLS_CERTDIR: "/certs"
  DOCKER_IMAGE: lexand-app:$CI_COMMIT_SHORT_SHA

build-image:
  stage: build
  image: docker:27.5-dind
  services:
    - docker:27.5-dind
  before_script:
    - docker info
  script:
    - docker build -f Dockerfile.test -t $DOCKER_IMAGE .
    - docker save $DOCKER_IMAGE -o lexand-image.tar
  artifacts:
    paths:
      - lexand-image.tar
    expire_in: 1 hour
  only:
    - merge_requests
    - main
    - develop

test:
  stage: test
  image: docker:27.5-dind
  services:
    - docker:27.5-dind
  dependencies:
    - build-image
  before_script:
    - docker load -i lexand-image.tar
  script:
    - docker run --rm -v $(pwd):/app -v /app/node_modules -e NODE_ENV=test $DOCKER_IMAGE bun test:run
  only:
    - merge_requests
    - main
    - develop

build:
  stage: test
  image: docker:27.5-dind
  services:
    - docker:27.5-dind
  dependencies:
    - build-image
  before_script:
    - docker load -i lexand-image.tar
  script:
    - docker run --rm -v $(pwd)/dist:/app/dist $DOCKER_IMAGE bun run build
  artifacts:
    paths:
      - dist/
    expire_in: 1 week
  only:
    - merge_requests
    - main
    - develop

package:
  stage: package
  image: alpine:latest
  dependencies:
    - build
  script:
    - tar -czf lexand-app-$CI_COMMIT_SHORT_SHA.tar.gz dist/
  artifacts:
    paths:
      - lexand-app-$CI_COMMIT_SHORT_SHA.tar.gz
    expire_in: 1 month
  only:
    - main
    - develop
