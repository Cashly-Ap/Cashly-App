FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache git wget unzip bash curl

RUN wget -qO- https://bun.sh/install | bash -s "bun-v1.3.3"
ENV PATH="/root/.bun/bin:${PATH}"

COPY package.json bunfig.toml ./

RUN bun install

COPY . .

COPY wait-for-backend.sh /usr/local/bin/wait-for-backend.sh
RUN chmod +x /usr/local/bin/wait-for-backend.sh

EXPOSE 4200

ENTRYPOINT ["wait-for-backend.sh"]
CMD ["./node_modules/.bin/ng", "serve", "--host", "0.0.0.0", "--poll", "2000"]
